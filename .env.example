# Copy to .env (git-ignored) and replace with your own random values.
# Example generator (PowerShell):  -join ((48..57)+(97..122) | Get-Random -Count 32 | % {[char]$_})
RATEGUARD_API_KEYS=replace-with-random-key-1,replace-with-random-key-2

# Optional overrides (defaults shown)
# RATEGUARD_ALGORITHM=FIXED_WINDOW        # or TOKEN_BUCKET
# RATEGUARD_LIMIT=5
# RATEGUARD_WINDOW=60s
# RATEGUARD_REDIS_FAILUREMODE=FAIL_CLOSED # or FAIL_OPEN
